{
  "name": "openspec-vscode-extension",
  "displayName": "OpenSpec for VS Code",
  "description": "Visual workspace for OpenSpec — browse and steer living specs, active changes, archived work, and custom workflow schemas directly in VS Code.",
  "version": "0.5.0",
  "publisher": "sebschre",
  "author": "Sebastian Schreiber <dev@sebastian-schreiber.com>",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebschre/openspec-vscode-extension"
  },
  "homepage": "https://github.com/sebschre/openspec-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/sebschre/openspec-vscode-extension/issues"
  },
  "qna": "https://github.com/sebschre/openspec-vscode-extension/discussions",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "openspec",
    "spec-driven",
    "specifications",
    "requirements",
    "ai",
    "agents",
    "claude",
    "copilot",
    "gemini",
    "antigravity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openspec",
          "title": "OpenSpec for VS Code",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "openspec": [
        {
          "id": "openspec.views.changes",
          "name": "Active Changes"
        },
        {
          "id": "openspec.views.specs",
          "name": "Living Specs"
        },
        {
          "id": "openspec.views.archive",
          "name": "Archive",
          "visibility": "collapsed"
        },
        {
          "id": "openspec.views.schemas",
          "name": "Schemas",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openspec.views.changes",
        "contents": "No openspec/ folder was found in this workspace.\nRun `openspec init` in the terminal to set up OpenSpec.\n[Open Terminal](command:openspec.openTerminal)",
        "when": "!openspec.hasRoot"
      },
      {
        "view": "openspec.views.changes",
        "contents": "No active changes yet.\n[New Change](command:openspec.newChange)\nA change holds a proposal, delta specs, a design and tasks until it is archived.",
        "when": "openspec.hasRoot"
      },
      {
        "view": "openspec.views.specs",
        "contents": "No openspec/ folder was found in this workspace.",
        "when": "!openspec.hasRoot"
      },
      {
        "view": "openspec.views.specs",
        "contents": "No living specs yet. Archiving a change promotes its delta specs into openspec/specs/.\n[New Change](command:openspec.newChange)",
        "when": "openspec.hasRoot"
      }
    ],
    "commands": [
      {
        "command": "openspec.newChange",
        "title": "New Change",
        "category": "OpenSpec",
        "icon": "$(plus)"
      },
      {
        "command": "openspec.refresh",
        "title": "Refresh Specs & Changes",
        "category": "OpenSpec",
        "icon": "$(refresh)"
      },
      {
        "command": "openspec.openViewer",
        "title": "Open Visual Spec Viewer",
        "category": "OpenSpec",
        "icon": "$(eye)"
      },
      {
        "command": "openspec.validate",
        "title": "Validate Change",
        "category": "OpenSpec",
        "icon": "$(check)"
      },
      {
        "command": "openspec.syncSpecs",
        "title": "Sync Specs to Main",
        "category": "OpenSpec",
        "icon": "$(sync)"
      },
      {
        "command": "openspec.archive",
        "title": "Archive Change",
        "category": "OpenSpec",
        "icon": "$(archive)"
      },
      {
        "command": "openspec.openSpecFile",
        "title": "Open spec.md",
        "category": "OpenSpec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openspec.revealArchiveInExplorer",
        "title": "Reveal in File Explorer",
        "category": "OpenSpec",
        "icon": "$(folder-opened)"
      },
      {
        "command": "openspec.openTerminal",
        "title": "Open Dedicated Terminal",
        "category": "OpenSpec",
        "icon": "$(terminal)"
      },
      {
        "command": "openspec.runInTerminal",
        "title": "Run in Dedicated Terminal",
        "category": "OpenSpec",
        "icon": "$(play)"
      },
      {
        "command": "openspec.resetTerminalSession",
        "title": "Reset Dedicated Terminal Session",
        "category": "OpenSpec"
      },
      {
        "command": "openspec.configureAgentCommand",
        "title": "Configure Agent Command",
        "category": "OpenSpec",
        "icon": "$(settings-gear)"
      },
      {
        "command": "openspec.schema.fork",
        "title": "Customize Schema (Fork to Project)",
        "category": "OpenSpec",
        "icon": "$(repo-forked)"
      },
      {
        "command": "openspec.schema.new",
        "title": "New Schema",
        "category": "OpenSpec",
        "icon": "$(new-file)"
      },
      {
        "command": "openspec.schema.validate",
        "title": "Validate Schema",
        "category": "OpenSpec",
        "icon": "$(check)"
      },
      {
        "command": "openspec.schema.setDefault",
        "title": "Set as Project Default Schema",
        "category": "OpenSpec",
        "icon": "$(star-empty)"
      },
      {
        "command": "openspec.schema.addArtifact",
        "title": "Add Artifact to Schema",
        "category": "OpenSpec",
        "icon": "$(add)"
      },
      {
        "command": "openspec.schema.removeArtifact",
        "title": "Remove Artifact from Schema",
        "category": "OpenSpec",
        "icon": "$(trash)"
      },
      {
        "command": "openspec.schema.editRequires",
        "title": "Edit Artifact Dependencies",
        "category": "OpenSpec",
        "icon": "$(references)"
      },
      {
        "command": "openspec.schema.compareWithOriginal",
        "title": "Compare with Original",
        "category": "OpenSpec",
        "icon": "$(diff)"
      },
      {
        "command": "openspec.schema.rename",
        "title": "Rename Schema",
        "category": "OpenSpec",
        "icon": "$(edit)"
      },
      {
        "command": "openspec.schema.delete",
        "title": "Delete Schema",
        "category": "OpenSpec",
        "icon": "$(trash)"
      },
      {
        "command": "openspec.schema.openDefinition",
        "title": "Open Definition in schema.yaml",
        "category": "OpenSpec",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openspec.schema.openFile",
        "title": "Open Schema File",
        "category": "OpenSpec"
      }
    ],
    "configuration": {
      "title": "OpenSpec for VS Code",
      "properties": {
        "openspec.terminal.agentCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that launches your AI coding agent in the OpenSpec terminal. `{command}` is replaced with the OpenSpec slash command; without it, the slash command is appended in quotes. Works with any agent CLI, for example:\n\n- Claude Code: `claude \"{command}\"`\n- Antigravity: `agy -i \"{command}\"`\n- Gemini CLI: `gemini -i \"{command}\"`\n- Codex CLI: `codex \"{command}\"`\n- opencode: `opencode --prompt \"{command}\"`\n\nRun **OpenSpec: Configure Agent Command** to pick one. If unset, the first terminal action offers the same picker."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "openspec.refresh",
          "when": "view =~ /^openspec\\.views\\./",
          "group": "navigation@1"
        },
        {
          "command": "openspec.newChange",
          "when": "view == openspec.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "openspec.openTerminal",
          "when": "view =~ /^openspec\\.views\\./",
          "group": "navigation@3"
        },
        {
          "command": "openspec.configureAgentCommand",
          "when": "view =~ /^openspec\\.views\\./",
          "group": "terminal@1"
        },
        {
          "command": "openspec.schema.new",
          "when": "view == openspec.views.schemas",
          "group": "navigation@2"
        },
        {
          "command": "openspec.schema.fork",
          "when": "view == openspec.views.schemas",
          "group": "1_schema@1"
        },
        {
          "command": "openspec.schema.setDefault",
          "when": "view == openspec.views.schemas",
          "group": "1_schema@2"
        }
      ],
      "view/item/context": [
        {
          "command": "openspec.openViewer",
          "when": "viewItem =~ /^change(\\.complete)?$/ || viewItem == spec || viewItem == archiveSpec",
          "group": "inline"
        },
        {
          "command": "openspec.archive",
          "when": "view == openspec.views.changes && viewItem == change.complete",
          "group": "inline@1"
        },
        {
          "command": "openspec.validate",
          "when": "view == openspec.views.changes && viewItem == change",
          "group": "inline@1"
        },
        {
          "command": "openspec.openSpecFile",
          "when": "view == openspec.views.specs && viewItem == spec",
          "group": "inline@1"
        },
        {
          "command": "openspec.validate",
          "when": "view == openspec.views.changes && viewItem =~ /^change(\\.complete)?$/",
          "group": "1_actions@1"
        },
        {
          "command": "openspec.archive",
          "when": "view == openspec.views.changes && viewItem =~ /^change(\\.complete)?$/",
          "group": "1_actions@2"
        },
        {
          "command": "openspec.syncSpecs",
          "when": "view == openspec.views.changes && viewItem =~ /^change(\\.complete)?$/",
          "group": "1_actions@3"
        },
        {
          "command": "openspec.revealArchiveInExplorer",
          "when": "viewItem == archiveItem || viewItem == archive || viewItem == archiveArtifact || viewItem == archiveSpec",
          "group": "navigation"
        },
        {
          "command": "openspec.schema.fork",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.(user|package)(\\.default)?(\\.fork)?$/",
          "group": "inline@1"
        },
        {
          "command": "openspec.schema.addArtifact",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.(project|user)/",
          "group": "inline@1"
        },
        {
          "command": "openspec.schema.validate",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.[a-z]+(\\.default)?(\\.fork)?$/",
          "group": "inline@2"
        },
        {
          "command": "openspec.schema.fork",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.project/",
          "group": "1_schema@1"
        },
        {
          "command": "openspec.schema.setDefault",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.[a-z]+(\\.fork|\\.unresolved)?$/",
          "group": "1_schema@2"
        },
        {
          "command": "openspec.schema.compareWithOriginal",
          "when": "view == openspec.views.schemas && viewItem =~ /\\.fork$/",
          "group": "inline@3"
        },
        {
          "command": "openspec.schema.compareWithOriginal",
          "when": "view == openspec.views.schemas && viewItem =~ /\\.fork$/",
          "group": "1_schema@3"
        },
        {
          "command": "openspec.schema.rename",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.project/",
          "group": "3_manage@1"
        },
        {
          "command": "openspec.schema.delete",
          "when": "view == openspec.views.schemas && viewItem =~ /^schema\\.project/",
          "group": "3_manage@2"
        },
        {
          "command": "openspec.schema.openDefinition",
          "when": "view == openspec.views.schemas && (viewItem =~ /^schemaArtifact/ || viewItem == schemaApply)",
          "group": "inline@0"
        },
        {
          "command": "openspec.schema.editRequires",
          "when": "view == openspec.views.schemas && viewItem == schemaArtifact.editable",
          "group": "inline@1"
        },
        {
          "command": "openspec.schema.removeArtifact",
          "when": "view == openspec.views.schemas && viewItem == schemaArtifact.editable",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "openspec.schema.openFile",
          "when": "false"
        },
        {
          "command": "openspec.schema.openDefinition",
          "when": "false"
        },
        {
          "command": "openspec.schema.removeArtifact",
          "when": "false"
        },
        {
          "command": "openspec.schema.editRequires",
          "when": "false"
        },
        {
          "command": "openspec.revealArchiveInExplorer",
          "when": "false"
        },
        {
          "command": "openspec.openSpecFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build:production",
    "build": "node esbuild.config.js",
    "build:production": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "validate:specs": "openspec validate --all --strict --no-interactive",
    "package": "vsce package --no-dependencies --readme-path docs/marketplace/README.md",
    "verify:vsix": "node scripts/verify-vsix.js"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@preact/signals": "^2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.84.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "preact": "^10.25.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.28.0"
}
